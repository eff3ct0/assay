{
  "version": 1,
  "checks": {
    "actionlint": {
      "exec": "actionlint",
      "fast": true,
      "enable": true,
      "requires": ".github/workflows/*",
      "coverage": null
    },
    "agents-md": {
      "exec": "assay builtin agents-md",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "ast-grep": {
      "exec": "assay builtin ast-grep",
      "fast": true,
      "enable": true,
      "requires": "sgconfig.yml",
      "coverage": null
    },
    "commit-trailers": {
      "exec": "assay builtin commit-trailers",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "gitleaks": {
      "exec": "assay builtin gitleaks",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "oxfmt": {
      "exec": "oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,mdx,yml,yaml}'",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "preset": {
      "exec": "assay builtin preset",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "suppressions": {
      "exec": "assay builtin suppressions",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    }
  },
  "loosenings": [],
  "coverage": {
    "newCode": 80
  },
  "languages": [],
  "rulePacks": {}
}
