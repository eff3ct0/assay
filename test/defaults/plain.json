{
  "version": 1,
  "checks": {
    "actionlint": {
      "exec": "actionlint",
      "fast": true,
      "enable": true,
      "requires": ".github/workflows/*"
    },
    "agents-md": {
      "exec": "assay builtin agents-md",
      "fast": true,
      "enable": true,
      "requires": null
    },
    "commit-trailers": {
      "exec": "assay builtin commit-trailers",
      "fast": true,
      "enable": true,
      "requires": null
    },
    "gitleaks": {
      "exec": "assay builtin gitleaks",
      "fast": true,
      "enable": true,
      "requires": null
    },
    "oxfmt": {
      "exec": "oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,mdx,yml,yaml}'",
      "fast": true,
      "enable": true,
      "requires": null
    },
    "suppressions": {
      "exec": "assay builtin suppressions",
      "fast": true,
      "enable": true,
      "requires": null
    }
  },
  "loosenings": []
}
