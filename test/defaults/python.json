{
  "version": 1,
  "checks": {
    "actionlint": {
      "exec": "actionlint",
      "fast": true,
      "enable": true,
      "requires": ".github/workflows/*",
      "coverage": null
    },
    "agents-md": {
      "exec": "assay builtin agents-md",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "ast-grep": {
      "exec": "assay builtin ast-grep",
      "fast": true,
      "enable": true,
      "requires": "sgconfig.yml",
      "coverage": null
    },
    "commit-trailers": {
      "exec": "assay builtin commit-trailers",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "deptry": {
      "exec": "assay-deptry",
      "fast": true,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "findings": {
      "exec": "assay builtin findings",
      "fast": false,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "gitleaks": {
      "exec": "assay builtin gitleaks",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "import-linter": {
      "exec": "if command -v lint-imports >/dev/null; then lint-imports; else echo \"lint-imports is not on the PATH: assay preset python adds import-linter to the project's development dependencies while this check is on\"; exit 127; fi",
      "fast": true,
      "enable": false,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "osv-scanner": {
      "exec": "assay builtin osv-scanner uv.lock",
      "fast": false,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "oxfmt": {
      "exec": "oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,mdx,yml,yaml}'",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "preset": {
      "exec": "assay builtin preset",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "pyright": {
      "exec": "pyright --warnings",
      "fast": false,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "pytest": {
      "exec": "assay-pytest \"$ASSAY_DIR/pytest\"",
      "fast": false,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": "$ASSAY_DIR/pytest/coverage.xml"
    },
    "ruff-check": {
      "exec": "ruff check --no-fix --extend-select RUF100",
      "fast": true,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "ruff-format": {
      "exec": "ruff format --check",
      "fast": true,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    },
    "suppressions": {
      "exec": "assay builtin suppressions",
      "fast": true,
      "enable": true,
      "requires": null,
      "coverage": null
    },
    "tla": {
      "exec": "assay builtin tla",
      "fast": false,
      "enable": false,
      "requires": "tla/*.cfg",
      "coverage": null
    },
    "vulture": {
      "exec": "vulture . --exclude .venv,.devenv",
      "fast": true,
      "enable": true,
      "requires": "pyproject.toml",
      "coverage": null
    }
  },
  "loosenings": [],
  "coverage": {
    "newCode": 80
  },
  "languages": ["python"],
  "rulePacks": {},
  "findings": {
    "duplication": {
      "nodes_threshold": 64
    },
    "radarlint": ["python"],
    "rules": {
      "python:S3776": false,
      "scala:S3776": false
    },
    "smells": {
      "boolean_logic": {
        "enable": true,
        "threshold": 4
      },
      "file_complexity": {
        "enable": true,
        "threshold": 50
      },
      "function_complexity": {
        "enable": true,
        "threshold": 18
      },
      "function_parameters": {
        "enable": true,
        "threshold": 6
      },
      "identical_code": {
        "enable": true,
        "threshold": 15
      },
      "nested_control_flow": {
        "enable": true,
        "threshold": 5
      },
      "return_statements": {
        "enable": true,
        "threshold": 6
      },
      "similar_code": {
        "enable": true,
        "threshold": 15
      }
    }
  }
}
