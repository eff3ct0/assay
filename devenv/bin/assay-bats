#!/usr/bin/env bash
# assay-bats <dir>: bash's test check. Runs bats over the .bats files git sees, under kcov, which writes a Cobertura
# report to <dir>/bats/cobertura.xml. The report lists every shell script git sees (what shfmt -f finds, test files
# aside), executed or not, and nothing else: so a new script no test runs counts as uncovered, and diff-cover counts
# no other language's lines. With no .bats file, kcov runs a stand-in for bats that reports no test, and the report
# still lists every script. <dir> is emptied first, since kcov adds to what it finds there. kcov's standard error, which mixes bats'
# own with the continuation lines of multi-line commands it traced, goes to <dir>/kcov.stderr.
set -euo pipefail

if [ $# -ne 1 ]; then
	echo "usage: assay-bats <dir>" >&2
	exit 2
fi
out=$(realpath -m "$1")
here=$(dirname "${BASH_SOURCE[0]}")
root=$(git rev-parse --show-toplevel)
cd "$root"
rm -rf "$out"
mkdir -p "$out/empty"

tests=()
while IFS= read -r -d '' f; do tests+=("$f"); done < <("$here/assay-files" '**/*.bats')
runner=(bats "${tests[@]}")
if [ ${#tests[@]} -eq 0 ]; then
	# Named bats, so that kcov writes the report to the same place.
	printf '#!%s\necho 1..0\n' "$(command -v bash)" >"$out/empty/bats"
	chmod +x "$out/empty/bats"
	runner=("$out/empty/bats")
fi

# kcov keeps the files under --include-path (a comma-separated list), and lists the ones nobody runs only when it
# parses them while walking --bash-parse-files-in-dir: the top-level directories that hold the scripts, or the root
# when one sits there. With no script, the include path is a directory that holds none.
include=()
declare -A dirs=()
while IFS= read -r f; do
	if [[ $f == *.bats ]]; then continue; fi
	include+=("$root/$f")
	dir=$root
	if [[ $f == */* ]]; then dir=$root/${f%%/*}; fi
	dirs[$dir]=1
done < <("$here/assay-files" | xargs -0 -r shfmt -f)
if [ -n "${dirs[$root]:-}" ]; then dirs=([$root]=1); fi
if [ ${#include[@]} -eq 0 ]; then include=("$out/empty/none"); fi

args=(--bash-parser="$(command -v bash)" --include-path="$(
	IFS=,
	echo "${include[*]}"
)")
if [ ${#dirs[@]} -gt 0 ]; then
	args+=(--bash-parse-files-in-dir="$(
		IFS=,
		echo "${!dirs[*]}"
	)")
fi
rc=0
kcov "${args[@]}" "$out" "${runner[@]}" 2>"$out/kcov.stderr" || rc=$?
if [ "$rc" -ne 0 ]; then
	echo "assay-bats: kcov's and bats' standard error: $1/kcov.stderr"
fi
exit "$rc"
