#!/usr/bin/env bash
# assay-deptry: deptry over the project, from the repo root, with the first deptry on the PATH: the venv's, which must
# see the project's environment to map distributions to the modules they install. pytest's conftest.py files are left
# out on top of what the repo leaves out: deptry leaves tests/ out by default but not conftest.py, which imports
# development dependencies (Python's preset's imports hypothesis). deptry's --extend-exclude replaces
# [tool.deptry] extend_exclude rather than adding to it, so the repo's own list goes along. deptry colours its output
# even when it is not a terminal's: --no-ansi.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
extend=$(
	python3 - <<'PY'
try:
    import tomllib
except ImportError:  # Python before 3.11, where deptry brings tomli
    import tomli as tomllib

try:
    with open("pyproject.toml", "rb") as f:
        config = tomllib.load(f)
except FileNotFoundError:
    config = {}
print(",".join(config.get("tool", {}).get("deptry", {}).get("extend_exclude", [])))
PY
)
echo "\$ deptry . --no-ansi --extend-exclude '${extend:+$extend,}(.*/)?conftest\.py'"
exec deptry . --no-ansi --extend-exclude "${extend:+$extend,}(.*/)?conftest\.py"
